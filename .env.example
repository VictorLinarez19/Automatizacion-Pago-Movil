# Copia este archivo como ".env" y completa los valores.
# ¡NUNCA subas el archivo .env real al repositorio!

# Credenciales del correo (Bancamiga)
EMAIL_USER=tu_correo@bancamiga.com
EMAIL_PASS=tu_contraseña
EMAIL_SERVER=imap.bancamiga.com

# Credenciales de la API de WhatsApp (green-api.com)
ID_INSTANCE=tu_id_de_instancia
API_TOKEN_INSTANCE=tu_token_de_instancia
